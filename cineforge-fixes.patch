+"""
+API integration tests for the real generate/animatic pipeline:
+
+  POST /api/scripts/upload    -> parse
+  POST /api/generate/storyboard -> generate + watermark + store a frame
+  POST /api/animatic/export     -> assemble stored frames into GIF/MP4
+
+Exercises the full chain through TestClient rather than mocking the
+service layer, since the whole point of this pass was replacing fake
+stubs with a real, working pipeline.
+"""
+
+import shutil
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+import src.backend.services.frame_store as frame_store
+import src.backend.services.script_store as script_store
+from src.backend.routers.animatic import router as animatic_router
+from src.backend.routers.generate import router as generate_router
+from src.backend.routers.scripts import router as scripts_router
+
+_HAS_FFMPEG = shutil.which("ffmpeg") is not None
+
+_app = FastAPI()
+_app.include_router(scripts_router, prefix="/api/scripts")
+_app.include_router(generate_router, prefix="/api/generate")
+_app.include_router(animatic_router, prefix="/api/animatic")
+_client = TestClient(_app, raise_server_exceptions=True)
+
+_SCRIPT_TEXT = (
+    "Title: The Long Wait\n\n"
+    "INT. BAKERY - DAWN\n"
+    "Mira kneads dough alone, exhausted. The oven hums.\n\n"
+    "EXT. STREET - NIGHT\n"
+    "Rain falls. Karim runs, tense, glancing over his shoulder.\n"
+)
+
+
+@pytest.fixture(autouse=True)
+def _clean_stores():
+    script_store.clear()
+    frame_store.clear()
+    yield
+    script_store.clear()
+    frame_store.clear()
+
+
+def _upload_script(text: str = _SCRIPT_TEXT) -> str:
+    resp = _client.post(
+        "/api/scripts/upload",
+        files={"file": ("script.txt", text.encode("utf-8"), "text/plain")},
+    )
+    assert resp.status_code == 202, resp.text
+    return resp.json()["script_id"]
+
+
+class TestStoryboardGeneration:
+    def test_generate_storyboard_returns_watermarked_placeholder_frame(self):
+        script_id = _upload_script()
+
+        resp = _client.post(
+            "/api/generate/storyboard",
+            json={"script_id": script_id, "scene_index": 0},
+        )
+
+        assert resp.status_code == 202, resp.text
+        body = resp.json()
+        assert body["watermarked"] is True
+        assert body["provider_id"] == "local-placeholder"  # no HF token in test env
+        assert body["image_url"].startswith("data:image/png;base64,")
+
+    def test_generate_storyboard_404s_for_unknown_script(self):
+        resp = _client.post(
+            "/api/generate/storyboard",
+            json={"script_id": "does-not-exist", "scene_index": 0},
+        )
+        assert resp.status_code == 404
+
+    def test_generate_storyboard_422s_for_out_of_range_scene_index(self):
+        script_id = _upload_script()  # has 2 scenes: indices 0, 1
+
+        resp = _client.post(
+            "/api/generate/storyboard",
+            json={"script_id": script_id, "scene_index": 99},
+        )
+        assert resp.status_code == 422
+
+    def test_generate_storyboard_stores_frame_for_later_animatic_export(self):
+        script_id = _upload_script()
+        assert not frame_store.has_frames(script_id)
+
+        _client.post("/api/generate/storyboard", json={"script_id": script_id, "scene_index": 0})
+
+        assert frame_store.has_frames(script_id)
+        frames = frame_store.get_frames(script_id)
+        assert len(frames) == 1
+        assert frames[0].scene_index == 0
+        assert frames[0].watermarked is True
+
+
+class TestFrameCount:
+    def test_frame_count_zero_before_any_generation(self):
+        script_id = _upload_script()
+
+        resp = _client.get(f"/api/generate/frames/{script_id}")
+
+        assert resp.status_code == 200
+        assert resp.json() == {"script_id": script_id, "frame_count": 0}
+
+    def test_frame_count_reflects_generated_frames(self):
+        script_id = _upload_script()
+        _client.post("/api/generate/storyboard", json={"script_id": script_id, "scene_index": 0})
+        _client.post("/api/generate/storyboard", json={"script_id": script_id, "scene_index": 1})
+
+        resp = _client.get(f"/api/generate/frames/{script_id}")
+
+        assert resp.json()["frame_count"] == 2
+
+    def test_frame_count_for_unknown_script_is_zero_not_error(self):
+        resp = _client.get("/api/generate/frames/never-uploaded")
+
+        assert resp.status_code == 200
+        assert resp.json()["frame_count"] == 0
+    def test_export_404s_when_no_frames_generated_yet(self):
+        script_id = _upload_script()
+
+        resp = _client.post("/api/animatic/export", json={"script_id": script_id})
+
+        assert resp.status_code == 404
+
+    def test_export_gif_after_generating_frames(self):
+        script_id = _upload_script()
+        _client.post("/api/generate/storyboard", json={"script_id": script_id, "scene_index": 0})
