+"""Generate router — storyboard and image generation.
+
+Storyboard pipeline (real, end-to-end)
+---------------------------------------
+1. Look up the parsed scene for ``(script_id, scene_index)`` in the
+   ephemeral script store (populated by ``POST /api/scripts/upload``).
+2. Build a ``CinematicPrompt`` directly from that scene's metadata —
+   deterministic, local, no LLM call. (The Granite scene-reasoning
+   provider in ``services/scene_reasoning.py`` can refine this in a
+   future pass; wiring it here would add a hard dependency on live
+   watsonx.ai credentials for the core demo path, so it's deliberately
+   not required for the pipeline to work.)
+3. Generate an image via ``get_default_provider()`` — a real Hugging
+   Face call if ``HUGGINGFACE_API_TOKEN`` is configured, otherwise a
+   real (non-AI) local placeholder render. Either way, real bytes.
+4. Watermark the result with a C2PA-inspired provenance manifest.
+5. Store the frame (``frame_store``) so ``POST /api/animatic/export``
+   can assemble it later.
+6. Return the frame as a base64 data URI — no separate file-serving
+   endpoint needed for the MVP.
+
+Audio generation remains an honest stub (see ``generate_audio`` below) —
+no offline-testable implementation was built for it this pass.
+"""
+
+import base64
 import time
-from fastapi import APIRouter, status
+
+from fastapi import APIRouter, HTTPException, status
 from pydantic import BaseModel, Field
 
+from src.backend.services import frame_store
+from src.backend.services.image_generation import (
+    GeneratedImage,
+    ImageGenerationError,
+    ImageGenerationService,
+    get_default_provider,
+)
+from src.backend.services.scene_reasoning import CameraAngle, CinematicPrompt, ShotType
+from src.backend.services.script_store import get as get_parsed_script
+from src.backend.services.watermark import WatermarkService
+
 router = APIRouter(tags=["generate"])
 
+_watermark_service = WatermarkService(project_id="cineforge-demo")
+
+# Deterministic mood -> shot/lighting mapping used to build a CinematicPrompt
+# without a live LLM call. Intentionally simple; a real Granite pass could
+# replace this with model-reasoned choices without changing the pipeline
+# shape.
+_MOOD_STYLE: dict[str, tuple[ShotType, CameraAngle, str]] = {
+    "tense": (ShotType.CLOSE_UP, CameraAngle.LOW_ANGLE, "harsh, high-contrast side lighting"),
+    "dark": (ShotType.WIDE, CameraAngle.HIGH_ANGLE, "low-key, deep shadow lighting"),
+    "romantic": (ShotType.MEDIUM, CameraAngle.EYE_LEVEL, "warm golden-hour backlight"),
+    "neutral": (ShotType.MEDIUM, CameraAngle.EYE_LEVEL, "soft diffused daylight"),
+}
+
+
+def _build_local_prompt(scene) -> CinematicPrompt:  # noqa: ANN001 — ParsedScene, avoid import cycle
+    shot_type, camera_angle, lighting = _MOOD_STYLE.get(
+        scene.mood, _MOOD_STYLE["neutral"]
+    )
+    environment = scene.heading or scene.location or "unspecified location"
+    visual_description = (
+        f"{shot_type.value} shot, {environment}. {scene.description}".strip()
+    )
+    return CinematicPrompt(
+        visual_description=visual_description or environment,
+        shot_type=shot_type,
+        camera_angle=camera_angle,
+        lighting=lighting,
+        mood=scene.mood or "neutral",
+        environment=environment,
+        characters=list(scene.characters),
+        negative_prompt="text, watermarks, blurry, low quality, distorted anatomy",
+    )
+
 
